# Copy this file to .env in the backend directory. Keep actual secrets out of git.
DATABASE_URL=postgresql+psycopg://toystack@localhost:5432/daylight
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
# Use "none" (with APP_ENV=production) when frontend and backend are on different root domains.
SESSION_COOKIE_SAMESITE=lax

# Google OAuth sign-in (register BACKEND_PUBLIC_URL/auth/google/callback in Google Cloud).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq is Daylight's default chat provider. Gemini is optional and appears when configured.
GROQ_API_KEY=
GEMINI_API_KEY=
